  m_Script: {fileID: 11500000, guid: d13dc2fe50d495e4a8a140e87f12b151, type: 3}
  m_Name: SOPetGuideTable
  m_EditorClassIdentifier: Assembly-CSharp::UI.SOPetGuideTable
  _entries:
  - Id: 1
    Message: "WASD\uB85C \uC774\uB3D9\uD558\uACE0,\nSpace\uB85C \uC810\uD504\uD560
      \uC218 \uC788\uC5B4\uC694!"
  - Id: 2
    Message: "\uACF5\uC911\uC5D0\uC11C Space\uB97C \uD55C \uBC88 \uB354 \uB204\uB974\uBA74\n\uB354\uBE14
      \uC810\uD504\uB97C \uD560 \uC218 \uC788\uC5B4\uC694!"
  - Id: 3
    Message: "Shift\uB97C \uB204\uB974\uBA74 \uBE60\uB974\uAC8C \uB300\uC2DC\uD574\uC694!"
  - Id: 4
    Message: "\uC2A4\uD0AC\uC744 \uC4F0\uBA74 \uBC30\uD130\uB9AC\uAC00 \uC904\uC5B4\uB4E4\uC5B4\uC694.\n\uBC30\uD130\uB9AC\uAC00
      \uBC14\uB2E5\uB098\uC9C0 \uC54A\uAC8C \uC870\uC2EC\uD574\uC694!"
  - Id: 5
    Message: "\uCD1D\uC744 \uC3D8\uBA74 \uACFC\uC5F4 \uAC8C\uC774\uC9C0\uAC00 \uCC28\uC62C\uB77C\uC694.\n\uAC00\uB4DD
      \uCC28\uBA74 \uC2DD\uC744 \uB54C\uAE4C\uC9C0 \uC3E0 \uC218 \uC5C6\uC5B4\uC694!"
  - Id: 6
    Message: "E \uD0A4\uB85C \uAC00\uAE4C\uC6B4 \uBB3C\uCCB4\uC640 \uC0C1\uD638\uC791\uC6A9\uD574\uC694.\n\uBA40\uB9AC
      \uC788\uB294 \uBB3C\uCCB4\uB294 \uB9C8\uC6B0\uC2A4 \uC67C\uCABD \uBC84\uD2BC\uC73C\uB85C\n\uC0C1\uD638\uC791\uC6A9\uD560
      \uC218 \uC788\uC5B4\uC694!"
  - Id: 7
    Message: "Q \uD0A4\uB85C \uC2A4\uCE94\uD558\uBA74 \uC8FC\uBCC0\uC744 \uC0B4\uD3B4\uBCFC
      \uC218 \uC788\uC5B4\uC694.\n\uC2A4\uCE94\uC73C\uB85C \uC5EC\uB7EC \uAC00\uC9C0\uB97C
      \uD560 \uC218 \uC788\uC5B4\uC694!"
  - Id: 8
    Message: "F \uD0A4\uB97C \uB204\uB974\uBA74 \uD0C8\uAC83\uC5D0 \uD0C8 \uC218
      \uC788\uC5B4\uC694!"
  - Id: 9
    Message: "\uD0C8\uAC83\uC744 \uD0C0\uBA74 \uB354\uBE14 \uC810\uD504\uC640\n\uC694\uC2DC
      \uC810\uD504\uB97C \uD560 \uC218 \uC788\uC5B4\uC694!"
