  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 535f65d6ca3349542b84294d93c4e93b, type: 3}
  m_Name: SODialogue_Tutorial_MusicFile
  m_EditorClassIdentifier: Assembly-CSharp::UI.Dialogue.SODialogue
  _id: Tutorial.MusicFile
  _lines:
  - SpeakerName: PET
    Portrait: {fileID: 21300000, guid: ceb3947f01fe6754481fd58faa91da91, type: 3}
    CameraIndex: -1
    Message: "\uD30C\uC77C\uC774 \uC5F4\uB838\uC5B4! \uC81C\uBAA9\uC774... '\uBD88\uC744
      \uB044\uAE30 \uC804\uC5D0 \xB7 \uB9C8\uC9C0\uB9C9 \uB370\uBAA8'?"
  - SpeakerName: PLAYER
    Portrait: {fileID: 0}
    CameraIndex: -1
    Message: "...\uC774 \uB178\uB798, \uACC4\uC18D \uB4E3\uACE0 \uC2F6\uC5B4."
  - SpeakerName: PET
    Portrait: {fileID: 21300000, guid: 0879fd8f8104c724f9a9324d90f9033e, type: 3}
    CameraIndex: -1
    Message: "\uD3F0 \uC8FC\uC778\uC774 \uB9CC\uB4E4\uB2E4 \uB9CC \uB370\uBAA8\uACE1\uC778\uAC00
      \uBD10.\n\uC5EC\uAE30 \uB450\uBA74 \uC18C\uAC01\uB3FC\uC11C \uC601\uC601 \uC0AC\uB77C\uC9C8
      \uAC70\uC57C."
  - SpeakerName: PLAYER
    Portrait: {fileID: 0}
    CameraIndex: -1
    Message: "\uADF8\uB7FC \uB0B4\uAC00 \uB4E4\uACE0 \uB098\uAC08\uAC8C."
  - SpeakerName: PET
    Portrait: {fileID: 21300000, guid: d9c2e7b85a7d3594083a23a4829733b1, type: 3}
    CameraIndex: -1
    Message: "\uC88B\uC544! \uD30C\uC77C\uC774 \uC544\uB798\uB85C \uB0B4\uB824\uAC00\uB294
      \uAE38\uC744 \uC5F4\uC5B4 \uC92C\uC5B4. \uAC00\uC790!"
