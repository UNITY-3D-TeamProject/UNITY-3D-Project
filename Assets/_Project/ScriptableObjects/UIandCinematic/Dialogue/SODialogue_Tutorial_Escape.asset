  _id: Tutorial.Escape
  _lines:
  - SpeakerName: "\uBE44\uD2B8"
    Portrait: {fileID: 21300000, guid: ceb3947f01fe6754481fd58faa91da91, type: 3}
    CameraIndex: -1
    Message: "\uD070\uC77C\uC774\uC57C! \uB4A4\uC5D0\uC11C \uB370\uC774\uD130 \uC9C0\uC6B0\uAC1C\uAC00
      \uAD74\uB7EC\uC624\uACE0 \uC788\uC5B4!"
  - SpeakerName: "\uCF54\uB9AC"
    Portrait: {fileID: 0}
    CameraIndex: -1
    Message: "\uC800\uAE30\uC5D0 \uB2FF\uC73C\uBA74 \uC5B4\uB5BB\uAC8C \uB418\uB294\uB370?"
  - SpeakerName: "\uBE44\uD2B8"
    Portrait: {fileID: 21300000, guid: 518ba6e15e207f943bb0ad6f2fd27afe, type: 3}
    CameraIndex: -1
    Message: "\uC6B0\uB9AC\uB3C4 \uAC19\uC774 \uC9C0\uC6CC\uC838!\n\uD0C8\uAC83\uC744
      \uD0C0\uACE0 \uCD9C\uAD6C\uAE4C\uC9C0 \uC804\uB825\uC73C\uB85C \uB2EC\uB824!"
