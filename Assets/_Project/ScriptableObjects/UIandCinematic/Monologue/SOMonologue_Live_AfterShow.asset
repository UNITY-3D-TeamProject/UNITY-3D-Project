  _lineDuration: 2.3
  _lines:
  - SpeakerName: "\uBE44\uD2B8"
    Portrait: {fileID: 0}
    Message: "\uC640\u2026 \uC9C4\uC9DC \uBB34\uB300\uC5D0 \uC130\uB124."
  - SpeakerName: "\uCF54\uB9AC"
    Portrait: {fileID: 0}
    Message: "\uADF8\uB7EC\uAC8C. \uCC98\uC74C \uB4E4\uC5C8\uB358 \uB178\uB798\uC796\uC544."
  - SpeakerName: "\uBE44\uD2B8"
    Portrait: {fileID: 0}
    Message: "\uC6B0\uB9AC\uAC00 \uD55C \uC77C\uC774 \uB3C4\uC6C0\uC774 \uB41C \uAC78\uAE4C?"
  - SpeakerName: "\uCF54\uB9AC"
    Portrait: {fileID: 0}
    Message: "\uADF8\uB798\uB3C4 \uB2E4\uC2DC \uB4E4\uC744 \uC218 \uC788\uC5B4\uC11C
      \uC88B\uC544."
  - SpeakerName: "\uBE44\uD2B8"
    Portrait: {fileID: 0}
    Message: "\uC774\uC81C \uC5B4\uB5BB\uAC8C \uD560 \uAC70\uC57C?"
  - SpeakerName: "\uCF54\uB9AC"
    Portrait: {fileID: 0}
    Message: "\uC870\uAE08\uB9CC \uB354 \uB4E3\uACE0 \uAC00\uC790."
