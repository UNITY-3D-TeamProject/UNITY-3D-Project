  m_Script: {fileID: 11500000, guid: 144d293f65d67b84e807ad18ea0182c0, type: 3}
  m_Name: SOMonologue_Security_UploadOffer
  m_EditorClassIdentifier: Assembly-CSharp::UIandCinematic.SOMonologue
  _lineDuration: 3
  _lines:
  - SpeakerName: "\uCF54\uB9AC"
    Portrait: {fileID: 0}
    Message: "\uC788\uC796\uC544! \uC5C4\uCCAD\uB09C \uC18C\uC2DD\uC774 \uC788\uC5B4!"
  - SpeakerName: "\uD0C0\uCF54"
    Portrait: {fileID: 0}
    Message: "\uBB54\uB370?"
  - SpeakerName: "\uCF54\uB9AC"
    Portrait: {fileID: 0}
    Message: "\uD3F0 \uC8FC\uC778\uC774 \uC644\uC131\uD55C \uB178\uB798\uB97C \uC9C1\uC811
      \uC62C\uB838\uB294\uB370, \uBC18\uC751\uC774 \uC815\uB9D0 \uC88B\uC544!"
  - SpeakerName: "\uD0C0\uCF54"
    Portrait: {fileID: 0}
    Message: "\uC798\uB410\uB2E4! \uC0AC\uB78C\uB4E4\uC774 \uB178\uB798\uB97C \uC88B\uC544\uD574
      \uC8FC\uB294\uAD6C\uB098!"
  - SpeakerName: "\uCF54\uB9AC"
    Portrait: {fileID: 0}
    Message: "\uADF8\uB7F0\uB370 \uADF8\uAC8C \uB05D\uC774 \uC544\uB2C8\uC57C! \uACF5\uC5F0
      \uC81C\uC548\uAE4C\uC9C0 \uB4E4\uC5B4\uC654\uC5B4!"
  - SpeakerName: "\uD0C0\uCF54"
    Portrait: {fileID: 0}
    Message: "\uACF5\uC5F0? \uADF8\uB7FC \uD3F0 \uC8FC\uC778\uC774 \uBB34\uB300\uC5D0
      \uC11C\uB294 \uAC70\uC57C?"
  - SpeakerName: "\uCF54\uB9AC"
    Portrait: {fileID: 0}
    Message: "\uC544\uC9C1 \uBAA8\uB974\uACA0\uC5B4. \uACF5\uC5F0\uC744 \uD560\uC9C0\uB294
      \uACE0\uBBFC \uC911\uC778\uAC00 \uBD10."
  - SpeakerName: "\uD0C0\uCF54"
    Portrait: {fileID: 0}
    Message: "\uAF2D \uBB34\uB300\uC5D0 \uC130\uC73C\uBA74 \uC88B\uACA0\uB2E4."
