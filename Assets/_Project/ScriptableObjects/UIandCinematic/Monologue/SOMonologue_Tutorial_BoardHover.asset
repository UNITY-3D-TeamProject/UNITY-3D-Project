  _lines:
  - SpeakerName: "\uBE44\uD2B8"
    Portrait: {fileID: 0}
    Message: "\uC774\uBC88\uC5D4 \uAF64 \uBA40\uB9AC \uB6F0\uC5B4\uC57C \uD560 \uAC70\uC57C!\n1\uB2E8
      \uC810\uD504\uC640 2\uB2E8 \uC810\uD504\uB97C \uD55C \uB4A4, \uACF5\uC911\uC5D0\uC11C
      Space\uB97C \uB2E4\uC2DC \uAFB9 \uB20C\uB7EC \uBD10!"
  - SpeakerName: "\uBE44\uD2B8"
    Portrait: {fileID: 0}
    Message: "\uADF8\uB7EC\uBA74 \uC7A0\uAE50 \uB3D9\uC548 \uACF5\uC911\uC744 \uB0A0\uC544\uAC08
      \uC218 \uC788\uC5B4!\n\uC774\uAC78 \uC774\uC6A9\uD574\uC11C \uC800 \uBA40\uB9AC
      \uC788\uB294 \uD2C8\uC744 \uB118\uC5B4 \uBD10!"
