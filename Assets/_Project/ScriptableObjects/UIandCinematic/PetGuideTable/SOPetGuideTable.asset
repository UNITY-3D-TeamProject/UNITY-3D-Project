  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d13dc2fe50d495e4a8a140e87f12b151, type: 3}
  m_Name: SOPetGuideTable
  m_EditorClassIdentifier: Assembly-CSharp::UI.SOPetGuideTable
  _entries:
  - Id: 1
    Message: "WASD\uB85C \uC774\uB3D9, Space\uB85C \uC810\uD504.\n\uADF8 \uC815\uB3C4\uB294
      \uD560 \uC218 \uC788\uC9C0?"
    Portrait: {fileID: 0}
  - Id: 2
    Message: "\uACF5\uC911\uC5D0\uC11C Space\uB97C \uD55C \uBC88 \uB354 \uB20C\uB7EC.\n\uB354\uBE14
      \uC810\uD504, \uADF8 \uC815\uB3C4\uB294 \uD560 \uC218 \uC788\uC9C0?"
    Portrait: {fileID: 0}
  - Id: 3
    Message: "Shift\uB97C \uB204\uB974\uBA74 \uBE60\uB974\uAC8C \uB300\uC2DC\uD574.\n\uB2A6\uC7A5
      \uBD80\uB9AC\uC9C0 \uB9D0\uACE0 \uB530\uB77C\uC640."
    Portrait: {fileID: 0}
  - Id: 4
    Message: "\uC2A4\uD0AC\uC744 \uC4F0\uBA74 \uBC30\uD130\uB9AC\uAC00 \uC904\uC5B4.\n\uBC14\uB2E5\uB098\uC9C0
      \uC54A\uAC8C \uC870\uC2EC\uD574."
    Portrait: {fileID: 0}
  - Id: 5
    Message: "\uCD1D\uC744 \uC3D8\uBA74 \uACFC\uC5F4 \uAC8C\uC774\uC9C0\uAC00 \uCC28\uC62C\uB77C.\n\uAC00\uB4DD
      \uCC28\uBA74 \uC2DD\uC744 \uB54C\uAE4C\uC9C0 \uBABB \uC3F4."
    Portrait: {fileID: 0}
  - Id: 6
    Message: "E \uD0A4\uB85C \uAC00\uAE4C\uC6B4 \uBB3C\uCCB4\uC640 \uC0C1\uD638\uC791\uC6A9\uD574.\n\uBA40\uB9AC
      \uC788\uB294 \uAC74 \uB9C8\uC6B0\uC2A4 \uC67C\uCABD \uBC84\uD2BC\uC73C\uB85C\n\uC0C1\uD638\uC791\uC6A9\uD558\uBA74
      \uB3FC."
    Portrait: {fileID: 0}
  - Id: 7
    Message: "Q \uD0A4\uB85C \uC2A4\uCE94\uD558\uBA74 \uC8FC\uBCC0\uC744 \uC0B4\uD3B4\uBCFC
      \uC218 \uC788\uC5B4.\n\uC228\uC740 \uAC83\uB3C4 \uCC3E\uC744 \uC218 \uC788\uC73C\uB2C8\uAE4C
      \uC790\uC8FC \uC368."
    Portrait: {fileID: 0}
  - Id: 8
    Message: "F \uD0A4\uB97C \uB204\uB974\uBA74 \uD0C8\uAC83\uC5D0 \uD0C8 \uC218
      \uC788\uC5B4."
    Portrait: {fileID: 0}
  - Id: 9
    Message: "\uD0C8\uAC83\uC744 \uD0C0\uBA74 \uB354\uBE14 \uC810\uD504\uB791\n\uC694\uC2DC
      \uC810\uD504\uB3C4 \uD560 \uC218 \uC788\uC5B4."
    Portrait: {fileID: 0}
  - Id: 10
    Message: "\uD0C8\uAC83\uC744 \uD0C4 \uCC44 Space\uB97C \uB204\uB974\uBA74 \uC810\uD504\uD574.\n\uC55E\uC758
      \uD2C8\uC744 \uB6F0\uC5B4\uB118\uC5B4!"
    Portrait: {fileID: 0}
  - Id: 11
    Message: "\uACF5\uC911\uC5D0\uC11C Space\uB97C \uD55C \uBC88 \uB354 \uB204\uB974\uBA74
      \uB354\uBE14 \uC810\uD504!\n\uC810\uD504 \uD558\uB098\uB85C\uB294 \uC548 \uB2FF\uB294
      \uD2C8\uC774\uC57C."
    Portrait: {fileID: 0}
  - Id: 12
    Message: "\uACF5\uC911 \uC810\uD504\uB97C \uB2E4 \uC4F4 \uB4A4 Space\uB97C \uAFB9
      \uB204\uB974\uACE0 \uC788\uC73C\uBA74\n\uC694\uC2DC \uC810\uD504\uB85C \uC7A0\uAE50
      \uB5A0\uC624\uB97C \uC218 \uC788\uC5B4.\n\uAC00\uC7A5 \uBA3C \uD2C8\uC740 \uC694\uC2DC
      \uC810\uD504\uB85C \uB118\uC5B4!"
    Portrait: {fileID: 0}
  - Id: 13
    Message: "\uC557, \uBC30\uD130\uB9AC\uAC00 \uAC70\uC758 \uB2E4 \uB5A8\uC5B4\uC84C\uC5B4!"
    Portrait: {fileID: 0}
  - Id: 14
    Message: "\uB0B4 \uBC30\uD130\uB9AC\uB97C \uB098\uB220 \uC904\uAC8C.\n\uB531 \uD55C \uBC88\uB9CC \uD560 \uC218 \uC788\uC73C\uB2C8\uAE4C \uB05D\uAE4C\uC9C0 \uB2EC\uB824!"
    Portrait: {fileID: 0}
