  m_Script: {fileID: 11500000, guid: d13dc2fe50d495e4a8a140e87f12b151, type: 3}
  m_Name: SOPetGuideTable
  m_EditorClassIdentifier: Assembly-CSharp::UI.SOPetGuideTable
  _entries:
  - Id: 1
    Message: "WASD\uB85C \uC774\uB3D9, Space\uB85C \uC810\uD504.\n\uADF8 \uC815\uB3C4\uB294
      \uD560 \uC218 \uC788\uC9C0?"
    Portrait: {fileID: 0}
  - Id: 2
    Message: "\uACF5\uC911\uC5D0\uC11C Space\uB97C \uD55C \uBC88 \uB354 \uB20C\uB7EC.\n\uB354\uBE14
      \uC810\uD504, \uADF8 \uC815\uB3C4\uB294 \uD560 \uC218 \uC788\uC9C0?"
    Portrait: {fileID: 0}
  - Id: 3
    Message: "Shift\uB97C \uB204\uB974\uBA74 \uBE60\uB974\uAC8C \uB300\uC2DC\uD574.\n\uB2A6\uC7A5
      \uBD80\uB9AC\uC9C0 \uB9D0\uACE0 \uB530\uB77C\uC640."
    Portrait: {fileID: 0}
  - Id: 4
    Message: "\uC2A4\uD0AC\uC744 \uC4F0\uBA74 \uBC30\uD130\uB9AC\uAC00 \uC904\uC5B4.\n\uBC14\uB2E5\uB098\uC9C0
      \uC54A\uAC8C \uC870\uC2EC\uD574."
    Portrait: {fileID: 0}
  - Id: 5
    Message: "\uCD1D\uC744 \uC3D8\uBA74 \uACFC\uC5F4 \uAC8C\uC774\uC9C0\uAC00 \uCC28\uC62C\uB77C.\n\uAC00\uB4DD
      \uCC28\uBA74 \uC2DD\uC744 \uB54C\uAE4C\uC9C0 \uBABB \uC3F4."
    Portrait: {fileID: 0}
  - Id: 6
    Message: "E \uD0A4\uB85C \uAC00\uAE4C\uC6B4 \uBB3C\uCCB4\uC640 \uC0C1\uD638\uC791\uC6A9\uD574.\n\uBA40\uB9AC
      \uC788\uB294 \uAC74 \uB9C8\uC6B0\uC2A4 \uC67C\uCABD \uBC84\uD2BC\uC73C\uB85C\n\uC0C1\uD638\uC791\uC6A9\uD558\uBA74
      \uB3FC."
    Portrait: {fileID: 0}
  - Id: 7
    Message: "Q \uD0A4\uB85C \uC2A4\uCE94\uD558\uBA74 \uC228\uC740 \uBC1C\uD310\uC744
      \uCC3E\uB294 \uB4F1 \uC5EC\uB7EC \uAC00\uC9C0\uB97C \uD560 \uC218 \uC788\uC5B4.\n\uC9C0\uAE08
      \uD55C\uBC88 \uC368 \uBCFC\uB798?"
    Portrait: {fileID: 0}
  - Id: 8
    Message: "F \uD0A4\uB97C \uB204\uB974\uBA74 \uD0C8\uAC83\uC5D0 \uD0C8 \uC218
      \uC788\uC5B4!"
    Portrait: {fileID: 0}
  - Id: 9
    Message: "\uD0C8\uAC83\uC5D0 \uD0C0\uBA74 \uC790\uB3D9\uC73C\uB85C \uC55E\uC73C\uB85C
      \uC6C0\uC9C1\uC5EC!\n\uC88C\uC6B0\uB85C \uBC29\uD5A5\uC744 \uC870\uC808\uD558\uBA74\uC11C
      \uC7A5\uC560\uBB3C\uC744 \uD53C\uD574 \uBD10!"
    Portrait: {fileID: 0}
  - Id: 10
    Message: "\uD0C8\uAC83\uC744 \uD0C4 \uC0C1\uD0DC\uC5D0\uC11C Space\uB97C \uB204\uB974\uBA74
      \uC810\uD504\uD560 \uC218 \uC788\uC5B4!\n\uC55E\uC5D0 \uC788\uB294 \uD2C8\uC744
      \uB6F0\uC5B4\uB118\uC5B4 \uBD10!"
    Portrait: {fileID: 0}
  - Id: 11
    Message: "\uC810\uD504\uD55C \uB4A4, \uACF5\uC911\uC5D0\uC11C Space\uB97C \uD55C
      \uBC88 \uB354 \uB204\uB974\uBA74 2\uB2E8 \uC810\uD504\uB97C \uD560 \uC218 \uC788\uC5B4!\n\uC77C\uBC18
      \uC810\uD504\uB85C \uB2FF\uC9C0 \uC54A\uB294 \uACF3\uB3C4 \uB118\uC5B4\uAC08
      \uC218 \uC788\uC9C0!"
    Portrait: {fileID: 0}
  - Id: 12
    Message: "\uC774\uBC88\uC5D4 \uAF64 \uBA40\uB9AC \uB6F0\uC5B4\uC57C \uD560 \uAC70\uC57C!\n1\uB2E8
      \uC810\uD504\uC640 2\uB2E8 \uC810\uD504\uB97C \uD55C \uB4A4, \uACF5\uC911\uC5D0\uC11C
      Space\uB97C \uB2E4\uC2DC \uAFB9 \uB20C\uB7EC \uBD10!\n\uADF8\uB7EC\uBA74 \uC7A0\uAE50
      \uB3D9\uC548 \uACF5\uC911\uC744 \uB0A0\uC544\uAC08 \uC218 \uC788\uC5B4!\n\uC774\uAC78
      \uC774\uC6A9\uD574\uC11C \uC800 \uBA40\uB9AC \uC788\uB294 \uD2C8\uC744 \uB118\uC5B4
      \uBD10!"
    Portrait: {fileID: 0}
  - Id: 13
    Message: "\uC557, \uBC30\uD130\uB9AC\uAC00 \uAC70\uC758 \uB2E4 \uB5A8\uC5B4\uC84C\uC5B4!"
    Portrait: {fileID: 0}
  - Id: 14
    Message: "\uB0B4 \uBC30\uD130\uB9AC\uB97C \uB098\uB220 \uC904\uAC8C!\n\uC774\uBC88\uC774
      \uB9C8\uC9C0\uB9C9\uC774\uB2C8\uAE4C \uB05D\uAE4C\uC9C0 \uB2EC\uB824!"
    Portrait: {fileID: 0}
