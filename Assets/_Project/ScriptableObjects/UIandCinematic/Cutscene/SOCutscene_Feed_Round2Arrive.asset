  - Type: 0
    SpeakerName: PLAYER
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uC7AC\uB8CC\uB294 \uB2E4\uC12F \uAC1C \uB2E4 \uCC59\uACBC\uC5B4.\n\uC774\uC81C
      \uBB58 \uD558\uBA74 \uB3FC?"
    ShouldRunTime: 0
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PET
    Portrait: {fileID: 0}
    CameraKey: Feed_Round2Console
    Message: "\uAC00\uC6B4\uB370 \uC800 \uAE30\uACC4 \uBCF4\uC5EC?\n\uAC00\uAE4C\uC774
      \uAC00\uC11C E\uB85C \uC0C1\uD638\uC791\uC6A9\uD558\uBA74 2\uB77C\uC6B4\uB4DC\uAC00
      \uC2DC\uC791\uB3FC."
    ShouldRunTime: 0
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PET
    Portrait: {fileID: 0}
    CameraKey: Feed_Round2Console
    Message: "\uC7AC\uB8CC\uAC00 \uD558\uB098\uB77C\uB3C4 \uBE60\uC9C0\uBA74 \uAE30\uACC4\uAC00
      \uC548 \uC6C0\uC9C1\uC5EC.\n\uADF8\uB550 \uB2E4\uC2DC \uB0B4\uB824\uAC00\uC11C
      \uCC3E\uC544 \uC640\uC57C \uD574."
    ShouldRunTime: 0
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PLAYER
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uC54C\uACA0\uC5B4. \uC6B0\uB9AC \uB178\uB798 \uD53C\uB4DC,\n\uC774\uC81C
