  - Type: 0
    SpeakerName: "\uCF54\uB9AC"
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uC6B0\uB9AC\uAC00 \uC62C\uB9B0 \uAC70, \uBD24\uC744\uAE4C?"
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: "\uBE44\uD2B8"
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uAC8C\uC2DC\uBB3C... \uADF8\uB300\uB85C \uC788\uC5B4! \uC548 \uC9C0\uC6E0\uC5B4!"
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: "\uCF54\uB9AC"
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uC815\uB9D0?"
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: "\uBE44\uD2B8"
    Portrait: {fileID: 0}
    CameraKey: Lobby_FilePortal
    Message: "\uADF8\uB9AC\uACE0 \uC9C0\uAE08 \uD30C\uC77C \uC571\uC744 \uB4A4\uC9C0\uACE0
      \uC788\uC5B4. '\uAC00\uC0AC', '\uB179\uC74C'... \uAC80\uC0C9 \uAE30\uB85D\uC774
      \uACC4\uC18D \uC313\uC5EC."
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: "\uCF54\uB9AC"
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uB2E4\uC2DC \uB178\uB798\uB97C \uB9CC\uB4E4\uB824\uB294 \uAC70\uC57C!"
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: "\uBE44\uD2B8"
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uADFC\uB370 \uAC80\uC0C9 \uACB0\uACFC\uAC00 \uB108\uBB34 \uB9CE\uC544\uC11C
      \uBABB \uCC3E\uACE0 \uC788\uC5B4. \uC6B0\uB9AC\uAC00 \uBA3C\uC800 \uCC3E\uC544
      \uC8FC\uC790!"
