  - Type: 0
    SpeakerName: "\uBE44\uD2B8"
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uB3CC\uC544\uC654\uB2E4! ...\uC7A0\uAE50, \uBC29\uAE08 \uC8FC\uC778\uC774
