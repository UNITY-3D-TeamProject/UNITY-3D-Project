  _steps:
  - Type: 0
    SpeakerName: "\uCF54\uB9AC"
    DisplayName: 
    Portrait: {fileID: 21300000, guid: c2cb645af22543c4282ecf8feaa122cf, type: 3}
    CameraKey: 
    Message: "\uD6C4... \uACA8\uC6B0 \uBE60\uC838\uB098\uC654\uB124.\n\uD558\uB9C8\uD130\uBA74
      \uB458 \uB2E4 \uC8FD\uC744 \uBED4\uD588\uC5B4."
    ShouldRunTime: 0
    IsPartnerTalk: 0
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: "\uD0C0\uCF54"
    DisplayName: 
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "...\uC5EC\uAE34 \uC5B4\uB514\uC57C?"
    ShouldRunTime: 0
    IsPartnerTalk: 0
    CameraShot: {fileID: 0}
  - Type: 1
    SpeakerName: 
    DisplayName: 
    Portrait: {fileID: 0}
    CameraKey: 
    Message: 
    ShouldRunTime: 0
    IsPartnerTalk: 0
    CameraShot: {fileID: 11400000, guid: 068f8e9f87665754a9bd7864aaca8f62, type: 2}
  - Type: 0
    SpeakerName: "\uCF54\uB9AC"
    DisplayName: 
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uC5EC\uAE34 \uD3F0 \uC8FC\uC778\uC758 \uD648 \uD654\uBA74\uC774\uC57C.\n\uC5B4\uB51C
      \uBD10\uB3C4 K-Culture\uBFD0\uC774\uC9C0?\n\uC8FC\uC778\uC774 \uBB34\uBA85
      K-POP \uC2F1\uC5B4\uC1A1\uB77C\uC774\uD130\uAC70\uB4E0."
    ShouldRunTime: 0
    IsPartnerTalk: 0
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: "\uD0C0\uCF54"
    DisplayName: 
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uADF8\uB7FC \uC544\uAE4C \uB4E4\uC5C8\uB358 \uB178\uB798\uB3C4 \uC8FC\uC778\uC774
      \uB9CC\uB4E0 \uAC70\uC57C?"
    ShouldRunTime: 0
    IsPartnerTalk: 0
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: "\uCF54\uB9AC"
    DisplayName: 
    Portrait: {fileID: 21300000, guid: 0879fd8f8104c724f9a9324d90f9033e, type: 3}
    CameraKey: 
    Message: "\uC751. \uD63C\uC790 \uB9CC\uB4E4\uB358 \uB178\uB798\uC778\uB370,\n\uC644\uC131\uD558\uC9C0
      \uBABB\uD558\uACE0 \uACB0\uAD6D \uBC84\uB9B0 \uBAA8\uC591\uC774\uC57C."
    ShouldRunTime: 0
    IsPartnerTalk: 0
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: "\uD0C0\uCF54"
    DisplayName: 
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uADF8\uB807\uAC8C \uC88B\uC740 \uB178\uB798\uC600\uB294\uB370...\n\uB2E4\uB978
      \uC0AC\uB78C\uB4E4\uB3C4 \uB4E4\uC5B4\uBD24\uC73C\uBA74 \uC88B\uACA0\uC5B4."
    ShouldRunTime: 0
    IsPartnerTalk: 0
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: "\uCF54\uB9AC"
    DisplayName: 
    Portrait: {fileID: 21300000, guid: c2cb645af22543c4282ecf8feaa122cf, type: 3}
    CameraKey: 
    Message: "\uB2E4\uB978 \uC0AC\uB78C\uB4E4\uD55C\uD14C \uB4E4\uB824\uC8FC\uACE0
      \uC2F6\uB2E4\uACE0?\n\uC74C... \uD53C\uB4DC \uC571\uC774\uB77C\uB294 \uACF3\uC774
      \uC788\uAE34 \uD55C\uB370..."
    ShouldRunTime: 0
    IsPartnerTalk: 0
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: "\uD0C0\uCF54"
    DisplayName: 
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uD53C\uB4DC \uC571? \uADF8\uAC8C \uBB54\uB370?"
    ShouldRunTime: 0
    IsPartnerTalk: 0
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: "\uCF54\uB9AC"
    DisplayName: 
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uC0AC\uC9C4\uC774\uB098 \uC74C\uC545\uC744 \uC62C\uB824\uC11C \uB2E4\uB978
      \uC0AC\uB78C\uB4E4\uACFC \uACF5\uC720\uD558\uB294 \uACF3\uC774\uC57C.\n\uAC70\uAE30\uC5D0
      \uC62C\uB9AC\uBA74 \uB204\uAD70\uAC00\uB294 \uB4E4\uC5B4\uC904\uC9C0\uB3C4
      \uBAA8\uB974\uC9C0."
    ShouldRunTime: 0
    IsPartnerTalk: 0
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: "\uD0C0\uCF54"
    DisplayName: 
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uADF8\uB7FC \uD55C\uBC88 \uAC00\uBCF4\uC790!"
    ShouldRunTime: 0
    IsPartnerTalk: 0
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: "\uCF54\uB9AC"
    DisplayName: 
    Portrait: {fileID: 21300000, guid: 518ba6e15e207f943bb0ad6f2fd27afe, type: 3}
    CameraKey: 
    Message: "\uC7A0\uAE50, \uADF8\uB807\uAC8C \uC26C\uC6B4 \uC77C\uC740 \uC544\uB2D0
      \uD150\uB370...\n\uBB50, \uC77C\uB2E8 \uAC00\uBCF4\uBA74 \uC54C\uACA0\uC9C0!"
    ShouldRunTime: 0
    IsPartnerTalk: 0
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: "\uCF54\uB9AC"
    DisplayName: 
    Portrait: {fileID: 21300000, guid: d9c2e7b85a7d3594083a23a4829733b1, type: 3}
    CameraKey: Lobby_FeedPortal
    Message: "\uC800\uAE30 \uC625\uC0C1 \uC704\uC5D0 \uC788\uB294 \uD53C\uB4DC \uC571
      \uC785\uAD6C \uBCF4\uC5EC?"
    ShouldRunTime: 0
    IsPartnerTalk: 0
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: "\uCF54\uB9AC"
    DisplayName: 
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uC800\uAE30\uAE4C\uC9C0 \uC62C\uB77C\uAC00\uBA74 \uB3FC!"
    ShouldRunTime: 0
    IsPartnerTalk: 0
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: "\uCF54\uB9AC"
    DisplayName: 
    Portrait: {fileID: 0}
    CameraKey: Lobby_ChargeStation
    Message: "\uC544, \uC5EC\uAE30\uC120 \uCCB4\uB825\uC774\uB791 \uBC30\uD130\uB9AC\uB3C4
      \uD68C\uBCF5\uD560 \uC218 \uC788\uC5B4."
    ShouldRunTime: 0
    IsPartnerTalk: 0
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: "\uCF54\uB9AC"
    DisplayName: 
    Portrait: {fileID: 21300000, guid: d9c2e7b85a7d3594083a23a4829733b1, type: 3}
    CameraKey: 
    Message: "\uC900\uBE44\uB410\uC73C\uBA74 \uCD9C\uBC1C\uD558\uC790!"
