  m_Script: {fileID: 11500000, guid: 5a996e19c4d83684a905dbed745d44a8, type: 3}
  m_Name: SOCutscene_Lobby_ReturnTutorial
  m_EditorClassIdentifier: Assembly-CSharp::UIandCinematic.SOCutscene
  _id: Lobby.ReturnTutorial
  _shouldPlayOnce: 0
  _endBlendSeconds: 1
  _steps:
  - Type: 0
    SpeakerName: PET
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uD6C4, \uBE60\uC838\uB098\uC654\uB2E4! \uC18C\uAC01\uC7A5 \uBC16\uC740
      \uCC98\uC74C\uC774\uC9C0?"
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PLAYER
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "...\uC5EC\uAE34 \uC5B4\uB514\uC57C? \uB208\uC774 \uBD80\uC154."
    CameraShot: {fileID: 0}
  - Type: 1
    SpeakerName: 
    Portrait: {fileID: 0}
    CameraKey: 
    Message: 
    CameraShot: {fileID: 11400000, guid: 068f8e9f87665754a9bd7864aaca8f62, type: 2}
  - Type: 0
    SpeakerName: PET
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uD3F0 \uC8FC\uC778\uC758 \uD648 \uD654\uBA74\uC774\uC57C. \uC5B4\uB51C
      \uBD10\uB3C4 K-POP\uBFD0\uC774\uC9C0? \uC8FC\uC778\uC774 \uAC00\uC218 \uC9C0\uB9DD\uC0DD\uC774\uAC70\uB4E0."
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PLAYER
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uADF8\uB7FC \uC544\uAE4C \uADF8 \uB178\uB798\uB3C4... \uC8FC\uC778\uC774
      \uBD80\uB978 \uAC70\uC57C?"
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PET
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uC751. \uADFC\uB370 \uC544\uBB34\uD55C\uD14C\uB3C4 \uC548 \uB4E4\uB824
      \uC900 \uAC83 \uAC19\uC544. \uD3F4\uB354 \uC81C\uC77C \uAE4A\uC740 \uACF3\uC5D0
      \uC228\uACA8 \uB1A8\uB354\uB77C."
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PLAYER
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uC774\uB807\uAC8C \uC88B\uC740\uB370. ...\uB2E4\uB978 \uC0AC\uB78C\uB4E4\uB3C4
      \uB4E4\uC5C8\uC73C\uBA74 \uC88B\uACA0\uB2E4."
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PET
    Portrait: {fileID: 0}
    CameraKey: Lobby_FeedPortal
    Message: "\uADF8\uB7FC \uBC29\uBC95\uC774 \uC788\uC5B4. \uC800\uAE30 \uC625\uC0C1
      \uC704, \uD53C\uB4DC \uC571 \uC785\uAD6C \uBCF4\uC774\uC9C0?"
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PET
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uB85C\uBE44\uC5D0\uC120 \uCCB4\uB825\uC774\uB791 \uBC30\uD130\uB9AC\uAC00
      \uB2E4\uC2DC \uCC28. \uC900\uBE44\uB418\uBA74 \uC625\uC0C1\uC73C\uB85C \uC62C\uB77C\uAC00\uC790!"
    CameraShot: {fileID: 0}
