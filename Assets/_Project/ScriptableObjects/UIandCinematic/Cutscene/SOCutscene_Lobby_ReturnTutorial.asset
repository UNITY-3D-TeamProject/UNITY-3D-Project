%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5a996e19c4d83684a905dbed745d44a8, type: 3}
  m_Name: SOCutscene_Lobby_ReturnTutorial
  m_EditorClassIdentifier: Assembly-CSharp::UIandCinematic.SOCutscene
  _endBlendSeconds: 1
  _steps:
  - Type: 0
    SpeakerName: PET
    Portrait: {fileID: 21300000, guid: c2cb645af22543c4282ecf8feaa122cf, type: 3}
    CameraKey:
    Message: "후... 겨우 빠져나왔네.\n하마터면 둘 다 죽을 뻔했어."
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PLAYER
    Portrait: {fileID: 0}
    CameraKey:
    Message: "...여긴 어디야?"
    CameraShot: {fileID: 0}
  - Type: 1
    SpeakerName:
    Portrait: {fileID: 0}
    CameraKey:
    Message:
    CameraShot: {fileID: 11400000, guid: 068f8e9f87665754a9bd7864aaca8f62, type: 2}
  - Type: 0
    SpeakerName: PET
    Portrait: {fileID: 0}
    CameraKey:
    Message: "여긴 폰 주인의 홈 화면이야.\n어딜 봐도 K-Culture뿐이지?\n주인이 무명 K-POP 싱어송라이터거든."
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PLAYER
    Portrait: {fileID: 0}
    CameraKey:
    Message: "그럼 아까 들었던 노래도 주인이 만든 거야?"
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PET
    Portrait: {fileID: 21300000, guid: 0879fd8f8104c724f9a9324d90f9033e, type: 3}
    CameraKey:
    Message: "응. 혼자 만들던 노래인데,\n완성하지 못하고 결국 버린 모양이야."
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PLAYER
    Portrait: {fileID: 0}
    CameraKey:
    Message: "그렇게 좋은 노래였는데...\n다른 사람들도 들어봤으면 좋겠어."
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PET
    Portrait: {fileID: 21300000, guid: c2cb645af22543c4282ecf8feaa122cf, type: 3}
    CameraKey:
    Message: "다른 사람들한테 들려주고 싶다고?\n음... 피드 앱이라는 곳이 있긴 한데..."
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PLAYER
    Portrait: {fileID: 0}
    CameraKey:
    Message: "피드 앱? 그게 뭔데?"
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PET
    Portrait: {fileID: 0}
    CameraKey:
    Message: "사진이나 음악을 올려서 다른 사람들과 공유하는 곳이야.\n거기에 올리면 누군가는 들어줄지도 모르지."
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PLAYER
    Portrait: {fileID: 0}
    CameraKey:
    Message: "그럼 한번 가보자!"
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PET
    Portrait: {fileID: 21300000, guid: 518ba6e15e207f943bb0ad6f2fd27afe, type: 3}
    CameraKey:
    Message: "잠깐, 그렇게 쉬운 일은 아닐 텐데...\n뭐, 일단 가보면 알겠지!"
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PET
    Portrait: {fileID: 21300000, guid: d9c2e7b85a7d3594083a23a4829733b1, type: 3}
    CameraKey: Lobby_FeedPortal
    Message: "저기 옥상 위에 있는 피드 앱 입구 보여?"
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PET
    Portrait: {fileID: 0}
    CameraKey:
    Message: "저기까지 올라가면 돼!\n아, 여기선 체력이랑 배터리도 회복할 수 있어."
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PET
    Portrait: {fileID: 21300000, guid: d9c2e7b85a7d3594083a23a4829733b1, type: 3}
    CameraKey:
    Message: "준비됐으면 출발하자!"
    CameraShot: {fileID: 0}
