%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5a996e19c4d83684a905dbed745d44a8, type: 3}
  m_Name: SOCutscene_Lobby_ReturnTutorial
  m_EditorClassIdentifier: Assembly-CSharp::UIandCinematic.SOCutscene
  _endBlendSeconds: 1
  _steps:
  - Type: 0
    SpeakerName: PET
    Portrait: {fileID: 21300000, guid: c2cb645af22543c4282ecf8feaa122cf, type: 3}
    CameraKey: 
    Message: "\uD6C4... \uBE60\uC838\uB098\uC654\uB2E4.\n\uB458 \uB2E4 \uC548 \uC9C0\uC6CC\uC84C\uB124."
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PLAYER
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "...\uC5EC\uAE34 \uC5B4\uB514\uC57C? \uB208\uC774 \uBD80\uC154."
    CameraShot: {fileID: 0}
  - Type: 1
    SpeakerName: 
    Portrait: {fileID: 0}
    CameraKey: 
    Message: 
    CameraShot: {fileID: 11400000, guid: 068f8e9f87665754a9bd7864aaca8f62, type: 2}
  - Type: 0
    SpeakerName: PET
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uD3F0 \uC8FC\uC778\uC758 \uD648 \uD654\uBA74\uC774\uC57C. \uC5B4\uB51C
      \uBD10\uB3C4 K-POP\uBFD0\uC774\uC9C0?\n\uC8FC\uC778\uC774 \uAC00\uC218 \uC9C0\uB9DD\uC0DD\uC774\uAC70\uB4E0."
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PLAYER
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uADF8\uB7FC \uC544\uAE4C \uADF8 \uB178\uB798\uB3C4... \uC8FC\uC778\uC774
      \uBD80\uB978 \uAC70\uC57C?"
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PET
    Portrait: {fileID: 21300000, guid: 0879fd8f8104c724f9a9324d90f9033e, type: 3}
    CameraKey: 
    Message: "\uC751. \uC544\uBB34\uD55C\uD14C\uB3C4 \uC548 \uB4E4\uB824 \uC8FC\uACE0\n\uD3F4\uB354
      \uC81C\uC77C \uAE4A\uC740 \uACF3\uC5D0 \uB123\uC5B4 \uB480\uB2E4\uAC00 \uBC84\uB9B0
      \uAC70\uC57C."
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PLAYER
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uC774\uB807\uAC8C \uC88B\uC740\uB370.\n...\uB2E4\uB978 \uC0AC\uB78C\uB4E4\uB3C4
      \uB4E4\uC5C8\uC73C\uBA74 \uC88B\uACA0\uB2E4."
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PET
    Portrait: {fileID: 21300000, guid: c2cb645af22543c4282ecf8feaa122cf, type: 3}
    CameraKey: 
    Message: "...\uC788\uC796\uC544. \uC18C\uAC01\uC7A5\uC5D0\uC11C \uB0B4\uB0B4
      \uC0DD\uAC01\uD588\uC5B4.\n\uC624\uB958\uC778 \uB108\uB97C \uC2E0\uACE0\uD574\uC57C
      \uD558\uB098."
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PLAYER
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "...\uC2E0\uACE0\uD560 \uAC70\uC57C?"
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PET
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uC548 \uD574. \uB124\uAC00 \uADF8 \uD30C\uC77C\uC744 \uB05D\uAE4C\uC9C0
      \uC548 \uB193\uB294 \uAC78 \uBD24\uAC70\uB4E0.\n\uD3F0\uC744 \uB9DD\uAC00\uB728\uB9AC\uB824\uB294
      \uB370\uC774\uD130\uB294 \uADF8\uB7F0 \uC9D3 \uC548 \uD574."
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PET
    Portrait: {fileID: 21300000, guid: 518ba6e15e207f943bb0ad6f2fd27afe, type: 3}
    CameraKey: 
    Message: "\uB300\uC2E0 \uD63C\uC790 \uB3CC\uC544\uB2E4\uB2C8\uAC8C\uB294 \uBABB
      \uB46C.\n\uBCF4\uC548 \uC571\uC5D0 \uAC78\uB9AC\uBA74 \uB10C \uBC14\uB85C \uACA9\uB9AC\uC57C."
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PET
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uADF8\uB7EC\uB2C8\uAE4C \uB0B4\uAC00 \uC606\uC5D0\uC11C \uB3C4\uC640\uC904\uAC8C.\n...\uAC10\uC2DC
      \uACB8."
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PLAYER
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uACE0\uB9C8\uC6CC. \uADF8\uB7FC \uC774 \uB178\uB798,\n\uC5B4\uB5BB\uAC8C
      \uD558\uBA74 \uB4E4\uB824\uC904 \uC218 \uC788\uC5B4?"
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PET
    Portrait: {fileID: 21300000, guid: d9c2e7b85a7d3594083a23a4829733b1, type: 3}
    CameraKey: Lobby_FeedPortal
    Message: "\uBC29\uBC95\uC774 \uC788\uC5B4. \uC800\uAE30 \uC625\uC0C1 \uC704,\n\uD53C\uB4DC
      \uC571 \uC785\uAD6C \uBCF4\uC774\uC9C0?"
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PET
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uBE5B\uB098\uB294 \uC785\uAD6C\uAC00 \uB2E4\uC74C \uBAA9\uC801\uC9C0\uC57C.\n\uB85C\uBE44\uC5D0\uC120
      \uCCB4\uB825\uC774\uB791 \uBC30\uD130\uB9AC\uB3C4 \uB2E4\uC2DC \uCC28."
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PET
    Portrait: {fileID: 21300000, guid: d9c2e7b85a7d3594083a23a4829733b1, type: 3}
    CameraKey: 
    Message: "\uC900\uBE44\uB418\uBA74 \uC625\uC0C1\uC73C\uB85C \uC62C\uB77C\uAC00\uC790!"
    CameraShot: {fileID: 0}
