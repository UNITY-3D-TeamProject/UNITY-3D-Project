  m_Script: {fileID: 11500000, guid: 5a996e19c4d83684a905dbed745d44a8, type: 3}
  m_Name: SOCutscene_Lobby_BeforeSecurity
  m_EditorClassIdentifier: Assembly-CSharp::UIandCinematic.SOCutscene
  _endBlendSeconds: 1
  _steps:
  - Type: 0
    SpeakerName: "\uBE44\uD2B8"
    Portrait: {fileID: 0}
    CameraKey: Lobby_SecurityPortal
    Message: "\uBCF4\uC548 \uC571\uC774 \uAC10\uC5FC\uB410\uC5B4. \uD30C\uC77C \uC571\uC758
      \uBC14\uC774\uB7EC\uC2A4\uB4E4, \uC5ED\uC2DC \uC804\uC870\uC600\uC5B4."
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: "\uCF54\uB9AC"
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "...\uC6B0\uB9AC \uB54C\uBB38\uC774\uC57C?"
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: "\uBE44\uD2B8"
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uC6B0\uB9AC\uAC00 \uB4DC\uB098\uB4E0 \uD754\uC801\uC744 \uD0C0\uACE0
      \uB4E4\uC5B4\uC654\uB098 \uBD10. \uBC14\uC774\uB7EC\uC2A4\uB294 \uC6B0\uB9AC\uAC00
      \uAC74\uB4DC\uB9B0 \uD30C\uC77C\uC744 \uC804\uBD80 \uC9C0\uC6B0\uB824 \uD574."
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: "\uCF54\uB9AC"
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uADF8\uB7FC \uB370\uBAA8\uACE1\uB3C4... \uC8FC\uC778\uC774 \uCC3E\uC740
      \uC790\uB8CC\uB3C4?"
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: "\uBE44\uD2B8"
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uC751. \uC8FC\uC778\uC774 \uACE1\uC744 \uC644\uC131\uD560 \uB54C\uAE4C\uC9C0
      \uC6B0\uB9AC\uAC00 \uB9C9\uC544\uC57C \uD574."
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: "\uCF54\uB9AC"
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uC774\uBC88\uC5D4 \uB0B4\uAC00 \uC9C0\uD0AC \uCC28\uB840\uC57C. \uAC00\uC790."
    CameraShot: {fileID: 0}
