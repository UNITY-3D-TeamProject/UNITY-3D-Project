    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PET
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uB20C\uB7EC \uBCF4\uAC8C \uB9CC\uB4E4\uB824\uACE0 \uADF8\uB7F4\uB4EF\uD558\uAC8C
