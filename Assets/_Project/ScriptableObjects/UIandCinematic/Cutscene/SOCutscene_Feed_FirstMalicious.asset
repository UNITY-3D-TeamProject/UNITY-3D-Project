  - Type: 0
    SpeakerName: PLAYER
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uCE58\uC6B0\uBA74 \uB418\uB294 \uAC70\uC9C0?"
    ShouldRunTime: 0
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PET
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uC751. \uADFC\uB370 \uC545\uC131 \uD53C\uB4DC\uB9C8\uB2E4 \uC5C6\uC560\uB294
