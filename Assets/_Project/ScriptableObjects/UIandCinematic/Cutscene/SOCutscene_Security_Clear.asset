    CameraShot: {fileID: 11400000, guid: 4e440786dc9d2a741b3eeb91a25bd7fe, type: 2}
  - Type: 0
    SpeakerName: PET
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uD574\uB0C8\uC5B4! \uBC14\uC774\uB7EC\uC2A4 \uC655\uC774 \uC4F0\uB7EC\uC84C\uC5B4!"
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PLAYER
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "...\uBAB8\uC774 \uC774\uC0C1\uD574. \uC190\uB05D\uC774 \uD750\uB824\uC838."
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PET
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uB108, \uB370\uC774\uD130\uAC00 \uAE68\uC9C0\uACE0 \uC788\uC5B4! \uBC14\uC774\uB7EC\uC2A4\uB791
      \uB108\uBB34 \uC624\uB798 \uB9DE\uBD99\uC5C8\uC5B4..."
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PLAYER
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uC8FC\uC778\uC740... \uACE1\uC740 \uC5B4\uB5BB\uAC8C \uB410\uC5B4?"
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PET
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uC9C0\uCF30\uC5B4. \uD30C\uC77C \uD558\uB098\uB3C4 \uC548 \uC9C0\uC6CC\uC84C\uC5B4.
      \uC9C0\uAE08 \uB0B4\uBCF4\uB0B4\uAE30 \uC911\uC774\uC57C."
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PLAYER
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uADF8\uB7FC \uB410\uB2E4. \uB0B4\uAC00 \uB9CC\uB4E0 \uB178\uB798\uB294
      \uC544\uB2C8\uC9C0\uB9CC... \uB0B4\uAC00 \uB3C4\uC654\uC5B4."
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PET
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uADF8\uB7F0 \uB9D0 \uD558\uC9C0 \uB9C8! \uB85C\uBE44\uB85C \uB3CC\uC544\uAC00\uC790,
      \uC5BC\uB978!"
    CameraShot: {fileID: 0}
