--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5a996e19c4d83684a905dbed745d44a8, type: 3}
  m_Name: SOCutscene_Tutorial_MusicFile
  m_EditorClassIdentifier: Assembly-CSharp::UIandCinematic.SOCutscene
  _id: Tutorial.MusicFile
  _shouldPlayOnce: 0
  _endBlendSeconds: 1
  _steps:
  - Type: 0
    SpeakerName: PET
    Portrait: {fileID: 21300000, guid: ceb3947f01fe6754481fd58faa91da91, type: 3}
    CameraKey: 
    Message: "\uD30C\uC77C\uC774 \uC5F4\uB838\uC5B4. \uD3F4\uB354 \uC774\uB984\uC774...\n'\uB9C8\uC9C0\uB9C9\uC73C\uB85C_\uD55C\uBC88\uB9CC'?"
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PLAYER
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uB178\uB798 \uC81C\uBAA9\uC740 '\uBD88\uC744 \uB044\uAE30 \uC804\uC5D0'.\n...\uC774
      \uB178\uB798, \uACC4\uC18D \uB4E3\uACE0 \uC2F6\uC5B4."
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PET
    Portrait: {fileID: 21300000, guid: 0879fd8f8104c724f9a9324d90f9033e, type: 3}
    CameraKey: 
    Message: "\uB9C8\uC9C0\uB9C9\uC73C\uB85C \uD55C \uBC88\uB9CC \uD574 \uBCF4\uACE0\n\uADF8\uB9CC\uB450\uB824\uB358
      \uACE1\uC778\uAC00 \uBD10. \uADF8\uB798\uC11C \uC5EC\uAE30 \uBC84\uB9B0 \uAC70\uACE0."
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PET
    Portrait: {fileID: 21300000, guid: c2cb645af22543c4282ecf8feaa122cf, type: 3}
    CameraKey: 
    Message: "\uC8FC\uC778\uC774 \uBC84\uB9B0 \uD30C\uC77C\uC740 \uADF8\uB0E5 \uB450\uB294
      \uAC8C \uB9DE\uC544.\n\uC18C\uAC01\uC7A5 \uBB3C\uAC74\uC744 \uB4E4\uACE0 \uB098\uAC00\uBA74
      \uACBD\uBCF4\uAC00 \uC6B8\uB824."
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PLAYER
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uADF8\uB798\uB3C4 \uC774\uAC8C \uB9C8\uC9C0\uB9C9\uC774\uBA74... \uC548
      \uB420 \uAC83 \uAC19\uC544.\n\uAC00\uC838\uAC08\uB798."
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PET
    Portrait: {fileID: 21300000, guid: b765be443fad5a14db1e18d8ef5a285b, type: 3}
    CameraKey: 
    Message: "\uB0B4 \uB9D0 \uC548 \uB4E4\uC5C8\uC5B4?!\n\uB4E4\uACE0 \uB098\uAC00\uBA74
      \uC548 \uB41C\uB2E4\uB2C8\uAE4C!"
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PET
    Portrait: {fileID: 21300000, guid: 518ba6e15e207f943bb0ad6f2fd27afe, type: 3}
    CameraKey: 
    Message: "...\uBD10, \uBC8C\uC368 \uACBD\uBCF4\uAC00 \uC6B8\uB9AC\uC796\uC544.
      \uC774\uC81C \uB0B4\uB824\uB194\uB3C4 \uC18C\uC6A9\uC5C6\uC5B4.\n\uAE38\uC740
      \uC5F4\uB838\uC73C\uB2C8\uAE4C \uC77C\uB2E8 \uC544\uB798\uB85C \uAC00!"
    CameraShot: {fileID: 0}
