  _endBlendSeconds: 1
  _steps:
  - Type: 0
    SpeakerName: PET
    Portrait: {fileID: 0}
    CameraKey: Lobby_FeedPortal
    Message: "\uC5EC\uAE30\uAC00 \uD53C\uB4DC \uC571\uC774\uC57C.\n\uC0AC\uB78C\uB4E4\uC774
      \uD558\uB8E8\uC5D0\uB3C4 \uBA87 \uBC88\uC529 \uB4E4\uC5EC\uB2E4\uBCF4\uB294
      \uACF3."
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PLAYER
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uC5EC\uAE30\uC5D0 \uADF8 \uB178\uB798\uB97C \uC62C\uB9AC\uBA74 \uC0AC\uB78C\uB4E4\uC774
      \uB4E4\uC5B4 \uC904\uAE4C?"
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PET
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uADF8\uB0E5 \uC62C\uB9AC\uBA74 \uB2E4\uB978 \uAC8C\uC2DC\uBB3C\uC5D0
      \uBB3B\uD600.\n\uC81C\uBAA9, \uC0AC\uC9C4, \uC74C\uC545, \uB0B4\uC6A9, \uD574\uC2DC\uD0DC\uADF8\uAE4C\uC9C0
      \uAC16\uCDB0\uC57C \uD574."
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PLAYER
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uC8FC\uC778 \uBAB0\uB798 \uC62C\uB9AC\uB294 \uAC70\uC796\uC544. ...\uAD1C\uCC2E\uC744\uAE4C."
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PET
    Portrait: {fileID: 21300000, guid: c2cb645af22543c4282ecf8feaa122cf, type: 3}
    CameraKey: 
    Message: "\uC18C\uAC01\uC7A5\uC5D0\uC120 \uB0B4\uAC00 \uB9D0\uB838\uC9C0.\n\uADFC\uB370
      \uC774\uBC88\uC5D4 \uC9C0\uC6B0\uB294 \uAC8C \uC544\uB2C8\uB77C \uB4E4\uB824
      \uC8FC\uB294 \uAC70\uC57C."
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PET
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uB0A8\uAE38\uC9C0 \uC9C0\uC6B8\uC9C0\uB294 \uC8FC\uC778\uC774 \uC815\uD560
      \uAC70\uC57C.\n\uC6B0\uB9B0 \uAE30\uD68C\uB9CC \uB9CC\uB4DC\uB294 \uAC70\uACE0."
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PLAYER
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "...\uC88B\uC544. \uB4E4\uC5B4\uAC00\uC790."
    CameraShot: {fileID: 0}
