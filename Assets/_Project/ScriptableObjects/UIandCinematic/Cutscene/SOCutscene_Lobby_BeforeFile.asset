  - Type: 0
    SpeakerName: "\uCF54\uB9AC"
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uC8FC\uC778\uC774 \uCC3E\uB358 \uAC8C \uBB50\uC600\uC9C0?"
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: "\uBE44\uD2B8"
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uC61B\uB0A0 \uAC00\uC0AC \uBA54\uBAA8, \uBA5C\uB85C\uB514 \uB179\uC74C,
      \uCF54\uB4DC \uC9C4\uD589 \uBA54\uBAA8. \uADF8\uB9AC\uACE0 \uC5EC\uAE30\uC800\uAE30
      \uD769\uC5B4\uC9C4 \uB370\uBAA8 \uD30C\uC77C\uB4E4."
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: "\uBE44\uD2B8"
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uADFC\uB370 \uD3F4\uB354 \uC815\uB9AC\uB97C \uD55C \uBC88\uB3C4 \uC548
      \uD588\uB098 \uBD10. \uC548\uC740 \uAC70\uC758 \uBBF8\uB85C\uC77C \uAC70\uC57C."
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: "\uCF54\uB9AC"
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uAE38 \uCC3E\uB294 \uAC74 \uC790\uC2E0 \uC788\uC5B4. \uAC00\uC790."
