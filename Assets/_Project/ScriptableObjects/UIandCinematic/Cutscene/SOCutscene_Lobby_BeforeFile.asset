  _steps:
  - Type: 0
    SpeakerName: "\uBE44\uD2B8"
    Portrait: {fileID: 0}
    CameraKey: Lobby_FilePortal
    Message: "\uD30C\uC77C \uC571\uC774\uC57C. \uC8FC\uC778\uC774 \uC800\uC7A5\uD55C
      \uAC74 \uC804\uBD80 \uC5EC\uAE30 \uC313\uC5EC \uC788\uC5B4."
