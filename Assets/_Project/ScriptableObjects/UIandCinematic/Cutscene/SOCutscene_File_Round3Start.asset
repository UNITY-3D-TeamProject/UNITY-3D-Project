  _steps:
  - Type: 0
    SpeakerName: ADMIN
    Portrait: {fileID: 0}
    CameraKey: FileMazeStaging
    Message: "\uAC80\uC99D\uC774 \uC644\uB8CC\uB418\uC5C8\uC2B5\uB2C8\uB2E4. \uC694\uCCAD\uD558\uC2E0
      \uC74C\uC545 \uC791\uC5C5 \uD30C\uC77C\uC744 \uC804\uB2EC\uD558\uACA0\uC2B5\uB2C8\uB2E4."
    ShouldRunTime: 0
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: ADMIN
    Portrait: {fileID: 0}
    CameraKey: FileMazeStaging
    Message: "\uAC00\uC0AC \uCD08\uC548, \uBA5C\uB85C\uB514 \uB179\uC74C, \uCF54\uB4DC
      \uC9C4\uD589 \uBA54\uBAA8\uC785\uB2C8\uB2E4. \uC18C\uC911\uD788 \uBCF4\uAD00\uD574
      \uC8FC\uC138\uC694."
    ShouldRunTime: 0
    CameraShot: {fileID: 0}
  - Type: 1
    SpeakerName: 
    Portrait: {fileID: 0}
    CameraKey: FileMazeStaging
    Message: 
    ShouldRunTime: 0
    CameraShot: {fileID: 11400000, guid: b015fa3b016229f4b9631fbd9ad8f1e0, type: 2}
  - Type: 0
    SpeakerName: PET
    Portrait: {fileID: 0}
    CameraKey: FileMazeStaging
    Message: "\uC640, \uAC00\uC0AC \uCD08\uC548\uC774\uB791 \uBA5C\uB85C\uB514 \uB179\uC74C\uC774
      \uADF8\uB300\uB85C \uB0A8\uC544 \uC788\uC5C8\uB124!"
    ShouldRunTime: 0
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PET
    Portrait: {fileID: 0}
    CameraKey: FileMazeStaging
    Message: "\uCF54\uB4DC \uC9C4\uD589 \uBA54\uBAA8\uB3C4 \uC788\uC5B4. \uD3F0 \uC8FC\uC778\uC774
      \uC608\uC804\uC5D0 \uB9CC\uB4E4\uB358 \uB178\uB798\uC758 \uB2E8\uC11C\uB4E4\uC774\uC57C."
    ShouldRunTime: 0
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PET
    Portrait: {fileID: 0}
    CameraKey: FileMazeStaging
    Message: "\uC774 \uC790\uB8CC\uB4E4\uC744 \uBCF4\uBA74 \uADF8\uB54C \uB5A0\uC62C\uB838\uB358
      \uC0DD\uAC01\uC774 \uB2E4\uC2DC \uAE30\uC5B5\uB0A0\uC9C0\uB3C4 \uBAB0\uB77C."
    ShouldRunTime: 0
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PET
    Portrait: {fileID: 0}
    CameraKey: FileMazeStaging
    Message: "\uC88B\uC544! \uC774 \uD30C\uC77C\uB4E4\uC744 \uD3F0 \uC8FC\uC778\uC5D0\uAC8C
      \uC804\uB2EC\uD558\uC790!"
    ShouldRunTime: 0
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PET
    Portrait: {fileID: 0}
    CameraKey: FileMazeStaging
    Message: "\uC5B4?! \uC800\uAE30 \uB3C4\uB451\uB4E4\uC774 \uBAB0\uB824\uC624\uACE0
      \uC788\uC5B4!"
    ShouldRunTime: 0
    CameraShot: {fileID: 0}
  - Type: 1
    SpeakerName: 
    Portrait: {fileID: 0}
    CameraKey: FileMazeStaging
    Message: 
    ShouldRunTime: 0
    CameraShot: {fileID: 11400000, guid: 16b9383c388bbd04db6ae215848b05a8, type: 2}
  - Type: 0
    SpeakerName: PET
    Portrait: {fileID: 0}
    CameraKey: FileMazeStaging
    Message: "\uC557, \uBC29\uAE08 \uBC1B\uC740 \uD30C\uC77C\uC744 \uAC00\uC838\uAC14\uC5B4!"
    ShouldRunTime: 0
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PET
    Portrait: {fileID: 0}
    CameraKey: FileMazeStaging
    Message: "\uBBF8\uB85C\uB85C \uB3C4\uB9DD\uCCE4\uC5B4! \uC804\uBD80 \uCAD3\uC544\uAC00\uC11C
      \uB418\uCC3E\uC790!"
