%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5a996e19c4d83684a905dbed745d44a8, type: 3}
  m_Name: SOCutscene_Tutorial
  m_EditorClassIdentifier: Assembly-CSharp::UIandCinematic.SOCutscene
  _endBlendSeconds: 1
  _steps:
  - Type: 0
    SpeakerName: PET
    Portrait: {fileID: 21300000, guid: ceb3947f01fe6754481fd58faa91da91, type: 3}
    CameraKey: 
    Message: "으앗! ...시스템 재시작 완료. 누, 누구야?"
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PLAYER
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uB098\uB3C4 \uBAB0\uB77C. \uB208\uC744 \uB5A0 \uBCF4\uB2C8 \uC5EC\uAE30\uC600\uC5B4."
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PET
    Portrait: {fileID: 21300000, guid: c2cb645af22543c4282ecf8feaa122cf, type: 3}
    CameraKey: 
    Message: "잠깐, 스캔해 볼게. ...식별 코드 없음. 등록 기록도 없음."
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PET
    Portrait: {fileID: 21300000, guid: b765be443fad5a14db1e18d8ef5a285b, type: 3}
    CameraKey: 
    Message: "너, 오류 데이터잖아! 오류는 퍼지면 폰 전체가 망가진다고."
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PLAYER
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uC624\uB958...? \uADF8\uAC8C \uB098\uC57C?"
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PET
    Portrait: {fileID: 21300000, guid: c2cb645af22543c4282ecf8feaa122cf, type: 3}
    CameraKey:
    Message: "여긴 데이터 소각장이야. 지워질 것들이 모이는 곳. 아까 그 충격에 나까지 여기로 튕겨 왔어."
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PET
    Portrait: {fileID: 21300000, guid: 518ba6e15e207f943bb0ad6f2fd27afe, type: 3}
    CameraKey: 
    Message: "너 같은 오류 데이터를 그냥 둬도 되는 건지 모르겠지만..."
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PET
    Portrait: {fileID: 21300000, guid: 518ba6e15e207f943bb0ad6f2fd27afe, type: 3}
    CameraKey:
    Message: "일단 여기서 빠져나가는 게 먼저야."
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PET
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "그렇다고 널 완전히 믿는 건 아니야. 이상한 짓은 하지 마!"
    CameraShot: {fileID: 0}
