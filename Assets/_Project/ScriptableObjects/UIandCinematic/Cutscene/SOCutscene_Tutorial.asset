--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5a996e19c4d83684a905dbed745d44a8, type: 3}
  m_Name: SOCutscene_Tutorial
  m_EditorClassIdentifier: Assembly-CSharp::UIandCinematic.SOCutscene
  _id: Tutorial.Intro
  _shouldPlayOnce: 0
  _endBlendSeconds: 1
  _steps:
  - Type: 0
    SpeakerName: PET
    Portrait: {fileID: 21300000, guid: ceb3947f01fe6754481fd58faa91da91, type: 3}
    CameraKey: 
    Message: "\uC73C\uC557! ...\uC2DC\uC2A4\uD15C \uC7AC\uC2DC\uC791 \uC644\uB8CC.\n\uB204,
      \uB204\uAD6C\uC57C?"
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PLAYER
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uB098\uB3C4 \uBAB0\uB77C. \uB208\uC744 \uB5A0 \uBCF4\uB2C8 \uC5EC\uAE30\uC600\uC5B4."
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PET
    Portrait: {fileID: 21300000, guid: c2cb645af22543c4282ecf8feaa122cf, type: 3}
    CameraKey: 
    Message: "\uC7A0\uAE50, \uC2A4\uCE94\uD574 \uBCFC\uAC8C.\n...\uC2DD\uBCC4 \uCF54\uB4DC
      \uC5C6\uC74C. \uB4F1\uB85D \uAE30\uB85D\uB3C4 \uC5C6\uC74C."
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PET
    Portrait: {fileID: 21300000, guid: b765be443fad5a14db1e18d8ef5a285b, type: 3}
    CameraKey: 
    Message: "\uB108, \uC624\uB958 \uB370\uC774\uD130\uC796\uC544!\n\uC624\uB958\uB294
      \uD37C\uC9C0\uBA74 \uD3F0 \uC804\uCCB4\uAC00 \uB9DD\uAC00\uC9C4\uB2E4\uACE0."
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PLAYER
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uC624\uB958...? \uADF8\uAC8C \uB098\uC57C?"
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PET
    Portrait: {fileID: 21300000, guid: c2cb645af22543c4282ecf8feaa122cf, type: 3}
    CameraKey: 
    Message: "\uC5EC\uAE34 \uB370\uC774\uD130 \uC18C\uAC01\uC7A5\uC774\uC57C. \uC9C0\uC6CC\uC9C8
      \uAC83\uB4E4\uC774 \uBAA8\uC774\uB294 \uACF3.\n\uC544\uAE4C \uADF8 \uCDA9\uACA9\uC5D0
      \uB098\uAE4C\uC9C0 \uC5EC\uAE30\uB85C \uD295\uACA8 \uC654\uC5B4."
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PET
    Portrait: {fileID: 21300000, guid: 518ba6e15e207f943bb0ad6f2fd27afe, type: 3}
    CameraKey: 
    Message: "...\uB108\uB97C \uC2E0\uACE0\uD560\uC9C0\uB294 \uB098\uAC00\uC11C \uC0DD\uAC01\uD560\uB798.\n\uC9C0\uAE08\uC740
      \uC5EC\uAE30\uC11C \uBE60\uC838\uB098\uAC00\uB294 \uAC8C \uBA3C\uC800\uC57C."
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PET
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uADF8\uB54C\uAE4C\uC9C4 \uAC19\uC774 \uB2E4\uB2C8\uC790.\n\uB300\uC2E0
      \uC218\uC0C1\uD55C \uC9D3 \uD558\uBA74 \uBC14\uB85C \uC54C\uC544\uCC4C \uAC70\uC57C."
    CameraShot: {fileID: 0}
