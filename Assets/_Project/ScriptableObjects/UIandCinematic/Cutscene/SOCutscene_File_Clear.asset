  _steps:
  - Type: 0
    SpeakerName: PET
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uB2E4 \uCC3E\uC558\uB2E4! \uAC00\uC0AC \uBA54\uBAA8, \uBA5C\uB85C\uB514
      \uB179\uC74C, \uCF54\uB4DC \uC9C4\uD589\uAE4C\uC9C0!"
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PLAYER
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uC544\uAE4C \uB3C4\uB9DD\uCE5C \uBC14\uC774\uB7EC\uC2A4\uB4E4... \uC65C
      \uD558\uD544 \uC74C\uC545 \uC790\uB8CC\uB9CC \uD6D4\uCCD0 \uAC14\uC744\uAE4C."
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PET
    Portrait: {fileID: 0}
    CameraKey: File_CorruptTrace
    Message: "\uAE00\uC384... \uC800\uB7F0 \uBC14\uC774\uB7EC\uC2A4\uAC00 \uC800\uC808\uB85C
      \uC0DD\uAE30\uC9C4 \uC54A\uB294\uB370."
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PET
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uC6B0\uB9AC\uAC00 \uC571\uC744 \uB4DC\uB098\uB4E4\uBA74\uC11C \uC5B4\uB518\uAC00
      \uD2C8\uC774 \uC0DD\uAE34 \uAC78\uC9C0\uB3C4 \uBAB0\uB77C."
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PLAYER
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "...\uC77C\uB2E8 \uC790\uB8CC\uBD80\uD130 \uC8FC\uC778 \uB208\uC5D0
      \uB744\uB294 \uACF3\uC5D0 \uB450\uC790. \uAC71\uC815\uC740 \uADF8\uB2E4\uC74C\uC5D0."
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PET
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uC751. \uCD5C\uADFC \uD56D\uBAA9 \uB9E8 \uC704\uC5D0 \uC62C\uB824
      \uB458\uAC8C. \uCD9C\uAD6C\uB85C \uAC00\uC790!"
    CameraShot: {fileID: 0}
