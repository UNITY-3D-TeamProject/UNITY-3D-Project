  _steps:
  - Type: 0
    SpeakerName: "\uBE44\uD2B8"
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uC800\uAE30 \uBD10! \uD30C\uC77C \uAD00\uB9AC\uC790\uC57C. \uC608\uC804
      \uC74C\uC545 \uD30C\uC77C\uC744 \uCC3E\uC744 \uC218 \uC788\uC744\uC9C0\uB3C4
      \uBAB0\uB77C!"
    ShouldRunTime: 0
    IsPartnerTalk: 1
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: "\uAD00\uB9AC\uC790"
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uC774\uACF3\uC740 \uC624\uB798\uB41C \uD30C\uC77C \uBCF4\uAD00 \uAD6C\uC5ED\uC785\uB2C8\uB2E4.
      \uD30C\uC77C\uC5D0 \uC811\uADFC\uD558\uB824\uBA74 \uAC80\uC99D\uC744 \uD1B5\uACFC\uD574\uC57C
      \uD569\uB2C8\uB2E4."
    ShouldRunTime: 0
    IsPartnerTalk: 1
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: "\uBE44\uD2B8"
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uAC80\uC99D? \uC5B4\uB5BB\uAC8C \uD558\uBA74 \uB3FC?"
    ShouldRunTime: 0
    IsPartnerTalk: 1
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: "\uAD00\uB9AC\uC790"
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uBBF8\uB85C\uC5D0\uC11C \uC22B\uC790 \uB178\uB4DC 3\uAC1C\uC640 \uC5F0\uC0B0\uC790
      \uB178\uB4DC 2\uAC1C\uB97C \uBAA8\uC544 \uC8FC\uC138\uC694."
    ShouldRunTime: 0
    IsPartnerTalk: 1
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: "\uAD00\uB9AC\uC790"
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uCD9C\uAD6C\uC758 \uBCF4\uB4DC \uCE78\uC744 \uC3D8\uBA74 \uBAA8\uC740
      \uAC12\uC73C\uB85C \uBC14\uB01D\uB2C8\uB2E4. \uBAA9\uD45C \uC22B\uC790\uAC00
      \uB418\uB3C4\uB85D \uAC12\uC744 \uBC30\uCE58\uD574 \uC8FC\uC138\uC694."
    ShouldRunTime: 0
    IsPartnerTalk: 1
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: "\uAD00\uB9AC\uC790"
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uACC4\uC0B0\uC740 \uC67C\uCABD\uBD80\uD130 \uCC28\uB840\uB300\uB85C
      \uC9C4\uD589\uB429\uB2C8\uB2E4. \uAC80\uC99D\uC744 \uB9C8\uCE58\uBA74 \uD30C\uC77C\uC744
      \uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4."
    ShouldRunTime: 0
    IsPartnerTalk: 1
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: "\uBE44\uD2B8"
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uC88B\uC544! \uB178\uB4DC\uB97C \uBAA8\uC544\uC11C \uBAA9\uD45C \uC22B\uC790\uB97C
      \uB9DE\uCDB0 \uBCF4\uC790!"
