    CameraKey: 
    Message: 
    CameraShot: {fileID: 11400000, guid: eb657459483c3d14b9a227696c1d62a4, type: 2}
  - Type: 0
    SpeakerName: PET
    Portrait: {fileID: 0}
    CameraKey: Feed_PillarTop
    Message: "\uC800 \uAE30\uB465 \uAF2D\uB300\uAE30\uAE4C\uC9C0 \uC62C\uB77C\uAC00\uBA74\uC11C
      \uD53C\uB4DC \uC7AC\uB8CC\uB97C \uBAA8\uC73C\uB294 \uAC70\uC57C."
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PET
    Portrait: {fileID: 0}
    CameraKey: Feed_DecoyFeed
    Message: "\uC870\uC2EC\uD574. \uAE38\uC744 \uB9C9\uC740 \uBD89\uC740 \uD53C\uB4DC\uB294
      \uC545\uC131 \uBBF8\uB07C\uC57C. \uC7AC\uB8CC \uC55E\uC744 \uAC00\uB85C\uB9C9\uACE0
      \uC788\uC5B4."
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PLAYER
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uC81C\uBAA9, \uC0AC\uC9C4, \uC74C\uC545, \uB0B4\uC6A9, \uD574\uC2DC\uD0DC\uADF8.
      \uB2E4\uC12F \uAC1C \uB2E4 \uBAA8\uC73C\uBA74 \uB418\uB294 \uAC70\uC9C0?"
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: PET
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uC751. \uB2E4 \uBAA8\uC73C\uBA74 \uC6B0\uB9AC \uB178\uB798 \uD53C\uB4DC\uAC00
