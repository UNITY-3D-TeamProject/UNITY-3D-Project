  _steps:
  - Type: 0
    SpeakerName: "\uCF54\uB9AC"
    DisplayName: 
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uB3C4\uCC29! \uC5EC\uAE30\uAC00 \uD53C\uB4DC \uC571 \uC548\uC774\uC57C.
      \uAC8C\uC2DC\uBB3C\uB4E4\uC774 \uC5EC\uAE30\uC800\uAE30 \uB5A0\uB2E4\uB2C8\uACE0
