    ShouldRunTime: 0
    IsPartnerTalk: 0
    CameraShot: {fileID: 0}
  - Type: 1
    SpeakerName: 
    DisplayName: 
    Portrait: {fileID: 0}
    CameraKey: 
    Message: 
    ShouldRunTime: 0
    IsPartnerTalk: 0
    CameraShot: {fileID: 11400000, guid: eb657459483c3d14b9a227696c1d62a4, type: 2}
  - Type: 0
    SpeakerName: "\uCF54\uB9AC"
    DisplayName: 
    Portrait: {fileID: 0}
    CameraKey: Feed_PillarTop
    Message: "\uC800\uAE30 \uAF2D\uB300\uAE30\uAE4C\uC9C0 \uC62C\uB77C\uAC00\uBA74\uC11C
      \uAC8C\uC2DC\uBB3C\uC5D0 \uD544\uC694\uD55C \uC7AC\uB8CC\uB97C \uBAA8\uC73C\uBA74
      \uB3FC."
    ShouldRunTime: 0
    IsPartnerTalk: 0
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: "\uCF54\uB9AC"
    DisplayName: 
    Portrait: {fileID: 0}
    CameraKey: Feed_DecoyFeed
    Message: "\uC800 \uBCF4\uB77C\uC0C9 \uD53C\uB4DC\uB4E4\uC740 \uC545\uC131 \uBBF8\uB07C
      \uD53C\uB4DC\uC57C. \uAC70\uC9D3 \uC815\uBCF4\uB098 \uACFC\uC7A5\uB41C \uB0B4\uC6A9\uC73C\uB85C
      \uC0AC\uB78C\uB4E4\uC744 \uC18D\uC774\uB294 \uAC8C\uC2DC\uBB3C\uC774\uC9C0."
    ShouldRunTime: 0
    IsPartnerTalk: 0
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: "\uCF54\uB9AC"
    DisplayName: 
    Portrait: {fileID: 0}
    CameraKey: Feed_DecoyFeed
    Message: "\uC7AC\uB8CC\uB97C \uAC00\uB85C\uB9C9\uACE0 \uC788\uC73C\uB2C8\uAE4C
      \uC81C\uAC70\uD558\uACE0 \uC7AC\uB8CC\uB97C \uBA39\uACE0 \uC9C0\uB098\uAC00\uBA74
      \uB3FC."
    ShouldRunTime: 0
    IsPartnerTalk: 0
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: "\uD0C0\uCF54"
    DisplayName: 
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uADF8\uB7EC\uB2C8\uAE4C \uC81C\uBAA9, \uC0AC\uC9C4, \uC74C\uC545,
      \uB0B4\uC6A9, \uD574\uC2DC\uD0DC\uADF8... \uB2E4\uC12F \uAC1C\uB97C \uBAA8\uC73C\uBA74
      \uB418\uB294 \uAC70\uC9C0?"
    ShouldRunTime: 0
    IsPartnerTalk: 0
    CameraShot: {fileID: 0}
  - Type: 0
    SpeakerName: "\uCF54\uB9AC"
    DisplayName: 
    Portrait: {fileID: 0}
    CameraKey: 
    Message: "\uC751. \uB2E4 \uBAA8\uC73C\uACE0 \uC5C5\uB85C\uB4DC\uD558\uBA74 \uAC8C\uC2DC\uBB3C\uC774
      \uC644\uC131\uB418\uB294 \uAC70\uC9C0. \uC77C\uB2E8 \uC62C\uB77C\uAC00 \uBD10."
    ShouldRunTime: 0
