  _stages:
  - Scene: 2
    AppName: "\uD53C\uB4DC"
    Icon: {fileID: 2800000, guid: ac23035ceca074546979e0d5031252d7, type: 3}
    Tips:
    - "Q \uc2a4\uce94\uc73c\ub85c \ubcf4\uc774\uc9c0 \uc54a\ub294 \ubc1c\ud310\uc744 \ucc3e\uc544 \uc62c\ub77c\uac00\uc138\uc694."
    - "\uc81c\ubaa9\u00b7\uc0ac\uc9c4\u00b7\uc74c\uc545\u00b7\ub0b4\uc6a9\u00b7\ud574\uc2dc\ud0dc\uadf8, \ub2e4\uc12f \uc7ac\ub8cc\ub97c \ubaa8\uc544 \ud53c\ub4dc\ub97c \uc644\uc131\ud558\uc138\uc694."
    - "\uc7ac\ub8cc \uc55e\uc744 \ub9c9\ub294 \uc545\uc131 \ud53c\ub4dc\ub97c \uc81c\uac70\ud558\uace0 \uc704\ucabd\uc73c\ub85c \ub098\uc544\uac00\uc138\uc694."
    - "\uc644\uc131\ud55c \ud53c\ub4dc\uc640 \uc77c\ubc18 \ud53c\ub4dc\ub97c \uc3f4 \uc54c\ub9de\uc740 \ud574\uc2dc\ud0dc\uadf8\ub85c \ubcf4\ub0b4\uc138\uc694."
  - Scene: 3
    AppName: "\uD30C\uC77C"
    Icon: {fileID: 2800000, guid: 42130c9cc76fb7049bd405fc3e0ac598, type: 3}
    Tips:
    - "1\ub77c\uc6b4\ub4dc\uc5d0\uc11c\ub294 \ubbf8\ub85c\uc758 \ucd9c\uad6c\ub97c \ucc3e\uc544 \ud0c8\ucd9c\ud558\uc138\uc694."
    - "Q \uc2a4\uce94\uc73c\ub85c \ubcbd \ub108\uba38\uc758 \uc22b\uc790\uc640 \uc5f0\uc0b0\uc790 \uc704\uce58\ub97c \ud655\uc778\ud558\uc138\uc694."
    - "\uc22b\uc790 3\uac1c\uc640 \uc5f0\uc0b0\uc790 2\uac1c\ub97c \ubaa8\uc544 \ucd9c\uad6c \ud328\ub110\uc758 \ub2e4\uc12f \uce78\uc744 \uc3d8\uc138\uc694."
    - "\ub9c8\uc9c0\ub9c9 \ubbf8\ub85c\uc5d0\uc11c\ub294 \uc81c\ud55c \uc2dc\uac04 \uc548\uc5d0 \ub3c4\ub9dd\uce58\ub294 \ubc14\uc774\ub7ec\uc2a4\ub97c \ubaa8\ub450 \uc7a1\uc73c\uc138\uc694."
  - Scene: 4
    AppName: "\uBCF4\uC548"
    Icon: {fileID: 2800000, guid: d4052a3f8340e87469445ea4dc5c76be, type: 3}
    Tips:
    - "Q \uc2a4\uce94\uc73c\ub85c \uc801\uc758 \uc57d\uc810\uc744 \ub4dc\ub7ec\ub0b4\uace0 \uadf8 \ubd80\uc704\ub97c \ub178\ub824\ubcf4\uc138\uc694."
    - "\uc5c4\ud3d0\ubb3c\uacfc \ubc1c\ud310\uc744 \uc774\uc6a9\ud574 \uc801\uc758 \uacf5\uaca9\uc744 \ud53c\ud558\uc138\uc694."
    - "\uc5f0\uc18d \uc0ac\uaca9\uc73c\ub85c \uacfc\uc5f4\ub418\uc9c0 \uc54a\ub3c4\ub85d \uac8c\uc774\uc9c0\ub97c \uc0b4\ud3b4\ubcf4\uc138\uc694."
    - "\uc774\ub3d9\ud615 \ubcf4\uc2a4\ub97c \uadf8\ub85c\uae30\uc2dc\ucf1c \uace0\uc815\ud615 \ubcf4\uc2a4\ub97c \uacf5\uaca9\ud560 \uae30\ud68c\ub97c \ub9cc\ub4dc\uc138\uc694."
  - Scene: 5
    AppName: "\uB77C\uC774\uBE0C"
    Icon: {fileID: 2800000, guid: 86fb26198548d2b418b5c0b2f6f59164, type: 3}
    Tips:
    - "\ub77c\uc774\ube0c \uc2a4\ud14c\uc774\uc9c0\ub294 \uc804\ud22c\ub098 \ud37c\uc990 \uc5c6\uc774 \uc9c4\ud589\ub429\ub2c8\ub2e4."
    - "\ud654\uba74 \uc18d LIVE \ud45c\uc2dc\uc640 \ubb34\ub300 \uc601\uc0c1\uc744 \uc9c0\ucf1c\ubcf4\uc138\uc694."
    - "\ud3f0 \uc8fc\uc778\uc758 \ub178\ub798\uac00 \ub9c8\uc9c0\ub9c9 \uc7a5\uba74\uc744 \ucc44\uc6c1\ub2c8\ub2e4."
