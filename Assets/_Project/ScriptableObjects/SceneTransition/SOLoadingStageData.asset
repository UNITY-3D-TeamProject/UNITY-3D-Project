  m_Script: {fileID: 11500000, guid: b599f0683663b944ba0c401b42cfafe6, type: 3}
  m_Name: SOLoadingStageData
  m_EditorClassIdentifier: Assembly-CSharp::SceneTransition.SOLoadingStageData
  _stages:
  - Scene: 2
    AppName: "\uD53C\uB4DC"
    Icon: {fileID: 2800000, guid: ac23035ceca074546979e0d5031252d7, type: 3}
    Tips:
    - "Q\uB85C \uC2A4\uCE94\uD558\uBA74 \uC228\uACA8\uC9C4 \uD50C\uB7AB\uD3FC\uC744
      \uBC1C\uACAC\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    - "\uC190\uC774 \uB2FF\uC9C0 \uC54A\uB294 \uC7A5\uCE58\uB294 \uCD1D\uC73C\uB85C
      \uC3F4\uC11C \uC791\uB3D9\uC2DC\uD0AC \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    - "\uC545\uC131 \uD53C\uB4DC\uB97C \uC5C6\uC560\uC57C \uADF8 \uB4A4\uC5D0 \uC788\uB294
      \uD53C\uB4DC \uC7AC\uB8CC\uB97C \uC5BB\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    - "\uACF5\uC911\uC5D0\uC11C Shift\uB85C \uAD6C\uB974\uBA74 \uBA3C \uBC1C\uD310\uAE4C\uC9C0
      \uB2FF\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uACF5\uC911\uC5D0\uC11C\uB294
      \uD55C \uBC88\uB9CC \uC4F8 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    - "\uBC14\uB2E5\uC73C\uB85C \uB5A8\uC5B4\uC9C0\uBA74 \uCCB4\uB825\uC774 \uC870\uAE08
      \uC904\uACE0 \uCCB4\uD06C\uD3EC\uC778\uD2B8\uB85C \uB3CC\uC544\uAC11\uB2C8\uB2E4."
  - Scene: 3
    AppName: "\uD30C\uC77C"
    Icon: {fileID: 2800000, guid: 42130c9cc76fb7049bd405fc3e0ac598, type: 3}
    Tips:
    - "Q\uB85C \uC2A4\uCE94\uD558\uBA74 \uBCBD \uB108\uBA38\uC5D0 \uC788\uB294 \uC544\uC774\uD15C\uB3C4
      \uBCF4\uC785\uB2C8\uB2E4."
    - "\uC22B\uC790\uC640 \uC5F0\uC0B0\uC790\uB97C \uBAA8\uC544 \uD30C\uC77C \uAD00\uB9AC\uC790\uBCF4\uB2E4
      \uC88B\uC740 \uC2DD\uC744 \uB9CC\uB4DC\uC138\uC694."
    - "\uB3C4\uB9DD\uCE58\uB294 \uBC14\uC774\uB7EC\uC2A4\uB97C \uC81C\uD55C \uC2DC\uAC04
      \uC548\uC5D0 \uBAA8\uB450 \uC7A1\uC73C\uC138\uC694."
    - "\uC704\uC5D0\uC11C \uB5A8\uC5B4\uC9C0\uB294 \uC7A5\uC560\uBB3C\uC740 Shift\uB85C
      \uAD74\uB7EC\uC11C \uD53C\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - Scene: 4
    AppName: "\uBCF4\uC548"
    Icon: {fileID: 2800000, guid: d4052a3f8340e87469445ea4dc5c76be, type: 3}
    Tips:
    - "\uC801\uC744 Q\uB85C \uC2A4\uCE94\uD558\uBA74 \uC57D\uC810\uC774 \uB4DC\uB7EC\uB0A9\uB2C8\uB2E4.
      \uC57D\uC810\uC744 \uB9DE\uD788\uBA74 \uB354 \uD070 \uD53C\uD574\uB97C \uC90D\uB2C8\uB2E4."
    - "\uC88C\uD074\uB9AD\uC744 1\uCD08 \uB3D9\uC548 \uB204\uB974\uACE0 \uC788\uC73C\uBA74
      \uAC15\uB825\uD55C \uCC28\uC9C0\uC0F7\uC774 \uB098\uAC11\uB2C8\uB2E4."
    - "\uC3E0\uC218\uB85D \uACFC\uC5F4 \uAC8C\uC774\uC9C0\uAC00 \uC624\uB985\uB2C8\uB2E4.
      \uAC00\uB4DD \uCC28\uBA74 \uC7A0\uC2DC \uC3E0 \uC218 \uC5C6\uC73C\uB2C8 \uC870\uC808\uD558\uC138\uC694."
    - "\uD070 \uBCF4\uC2A4\uB294 \uC2E4\uB4DC\uAC00 \uC0AC\uB77C\uC9C0\uAE30 \uC804\uAE4C\uC9C0
      \uD53C\uD574\uB97C \uBC1B\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4. \uC6C0\uC9C1\uC774\uB294
      \uBCF4\uC2A4\uBD80\uD130 \uB178\uB9AC\uC138\uC694."
    - "\uBC30\uD130\uB9AC\uB294 \uC800\uC808\uB85C \uCC28\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.
      \uCDA9\uC804 \uC544\uC774\uD15C\uC744 \uCC59\uAE30\uC138\uC694."
  - Scene: 5
    AppName: "\uB77C\uC774\uBE0C"
    Icon: {fileID: 2800000, guid: 86fb26198548d2b418b5c0b2f6f59164, type: 3}
    Tips:
    - "\uC774\uBC88 \uC2A4\uD14C\uC774\uC9C0\uB294 \uC870\uC791 \uC5C6\uC774 \uAC10\uC0C1\uD558\uB294
      \uBB34\uB300\uC785\uB2C8\uB2E4."
    - "\uD3F0 \uC8FC\uC778\uC758 \uCCAB \uBB34\uB300\uAC00 \uACE7 \uC2DC\uC791\uB429\uB2C8\uB2E4."
